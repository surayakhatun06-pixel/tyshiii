# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These identify your project and are safe to ship to the browser; security comes from
# Firebase Authentication + firestore.rules. Never put admin passwords or service-account
# keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
