+          {skipped.length > 0 && (
+            <details className="mt-2 text-xs text-muted-foreground">
+              <summary className="cursor-pointer">
+                Ignored lines ({skipped.length})
+              </summary>
+              <ul className="mt-1 space-y-0.5">
+                {skipped.slice(0, 50).map((s) => (
