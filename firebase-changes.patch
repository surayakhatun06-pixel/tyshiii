@@ -0,0 +1,242 @@
+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { Loader2, Search } from "lucide-react";
+
+import { browseMedia, getMedia, titleOf, type MediaCard } from "@/lib/anilist";
+import {
+  watchCatalog,
+  type AnimeRef,
+  type CloudAnime,
+} from "@/lib/cloud-episodes";
+import { describeFirebaseError } from "@/lib/firebase";
+import { cn } from "@/lib/utils";
+
+const input =
+  "h-10 w-full rounded-xl border border-border bg-surface px-3 text-sm outline-none transition placeholder:text-muted-foreground/60 focus:border-primary";
+
+const fromMedia = (m: MediaCard): AnimeRef => ({
+  anilistId: m.id,
+  title: titleOf(m),
+  poster: m.coverImage.extraLarge ?? m.coverImage.large ?? null,
+});
+
+/** Choose a title: from what's already in Firestore, an AniList search, or an AniList ID. */
+export function AnimePicker({
+  value,
+  onChange,
+}: {
+  value: AnimeRef | null;
+  onChange: (anime: AnimeRef) => void;
+}) {
+  const [catalog, setCatalog] = useState<CloudAnime[] | null>(null);
+  const [catalogError, setCatalogError] = useState<string | null>(null);
+  const [term, setTerm] = useState("");
+  const [debounced, setDebounced] = useState("");
+  const [idText, setIdText] = useState("");
+  const [idBusy, setIdBusy] = useState(false);
+  const [idError, setIdError] = useState<string | null>(null);
+
+  useEffect(
+    () =>
+      watchCatalog(
+        (list) => {
+          setCatalog(list);
+          setCatalogError(null);
+        },
+        (error) => setCatalogError(describeFirebaseError(error)),
+        200,
+      ),
+    [],
+  );
+
+  useEffect(() => {
+    const t = window.setTimeout(() => setDebounced(term.trim()), 350);
+    return () => window.clearTimeout(t);
+  }, [term]);
+
+  const search = useQuery({
+    queryKey: ["anilist", "admin-search", debounced],
+    queryFn: () =>
+      browseMedia({ search: debounced, perPage: 8, sort: ["SEARCH_MATCH"] }),
+    enabled: debounced.length >= 2,
+    staleTime: 60_000,
+  });
+
+  async function pickById() {
+    const id = Number(idText);
+    if (!Number.isSafeInteger(id) || id < 1)
+      return setIdError("Enter a numeric AniList ID.");
+    setIdBusy(true);
+    setIdError(null);
+    try {
+      onChange(fromMedia(await getMedia(id)));
+      setIdText("");
+    } catch (error) {
+      setIdError(
+        error instanceof TypeError
+          ? "Couldn't reach AniList. Check your connection and try again."
+          : "No anime found with that AniList ID.",
+      );
+    } finally {
+      setIdBusy(false);
+    }
+  }
+
+  return (
+    <section className="rounded-2xl border border-border bg-surface/40 p-4 md:p-5">
+      <h2 className="text-lg font-semibold tracking-tight">
+        1. Choose an anime
+      </h2>
+      <p className="mt-1 text-sm text-muted-foreground">
+        Episodes are linked to the AniList ID, the same ID used in your site's
+        anime pages (
+        <code className="rounded bg-surface-2 px-1">/anime/ID</code>).
+      </p>
+
+      <div className="mt-4 grid gap-3 md:grid-cols-[minmax(0,1fr)_16rem]">
+        <label className="relative">
+          <Search className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
+          <input
+            value={term}
+            onChange={(e) => setTerm(e.target.value)}
+            placeholder="Search AniList by name"
+            aria-label="Search anime"
+            className={cn(input, "pl-9")}
+          />
+        </label>
+        <div className="flex gap-2">
+          <input
+            value={idText}
+            onChange={(e) => setIdText(e.target.value.replace(/\D/g, ""))}
+            onKeyDown={(e) => e.key === "Enter" && pickById()}
+            inputMode="numeric"
+            placeholder="AniList ID"
+            aria-label="AniList ID"
+            className={input}
+          />
+          <button
+            type="button"
+            onClick={pickById}
+            disabled={idBusy || !idText}
+            className="inline-flex h-10 shrink-0 items-center gap-1 rounded-full border border-border px-4 text-sm transition hover:border-primary disabled:opacity-50"
+          >
+            {idBusy && <Loader2 className="size-3.5 animate-spin" />}
+            Open
+          </button>
+        </div>
+      </div>
+      {idError && <p className="mt-2 text-xs text-destructive">{idError}</p>}
+
+      {debounced.length >= 2 && (
+        <div className="mt-3">
+          {search.isLoading ? (
+            <p className="flex items-center gap-2 text-xs text-muted-foreground">
+              <Loader2 className="size-3.5 animate-spin" /> Searching…
+            </p>
+          ) : search.isError ? (
+            <p className="text-xs text-destructive">
+              AniList search failed. Try again.
+            </p>
+          ) : search.data?.media.length ? (
+            <ul className="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
+              {search.data.media.map((m) => (
+                <li key={m.id}>
+                  <AnimeChoice
+                    anime={fromMedia(m)}
+                    active={value?.anilistId === m.id}
+                    onSelect={() => {
+                      onChange(fromMedia(m));
+                      setTerm("");
+                    }}
+                  />
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <p className="text-xs text-muted-foreground">No matches.</p>
+          )}
+        </div>
+      )}
+
+      <div className="mt-5">
+        <p className="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
+          Already in your database
+        </p>
+        {catalogError ? (
+          <p className="mt-2 text-xs text-destructive">{catalogError}</p>
+        ) : catalog === null ? (
+          <p className="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
+            <Loader2 className="size-3.5 animate-spin" /> Loading…
+          </p>
+        ) : catalog.length === 0 ? (
+          <p className="mt-2 text-xs text-muted-foreground">
+            Nothing yet. Search for an anime above to add its first episodes.
+          </p>
+        ) : (
+          <ul className="mt-2 grid max-h-72 gap-2 overflow-y-auto sm:grid-cols-2 lg:grid-cols-4">
+            {catalog.map((a) => (
+              <li key={a.anilistId}>
+                <AnimeChoice
+                  anime={a}
+                  active={value?.anilistId === a.anilistId}
+                  detail={`${a.episodeCount} ep · SUB ${a.subCount} · DUB ${a.dubCount}`}
+                  onSelect={() =>
+                    onChange({
+                      anilistId: a.anilistId,
+                      title: a.title,
+                      poster: a.poster,
+                    })
+                  }
+                />
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </section>
+  );
+}
+
+function AnimeChoice({
+  anime,
+  active,
+  detail,
+  onSelect,
+}: {
+  anime: AnimeRef;
+  active: boolean;
+  detail?: string;
+  onSelect: () => void;
+}) {
+  return (
+    <button
+      type="button"
+      onClick={onSelect}
+      aria-pressed={active}
+      className={cn(
+        "flex w-full items-center gap-3 rounded-xl p-2 text-left ring-1 transition",
+        active
+          ? "bg-primary/10 ring-primary/70"
+          : "bg-surface/60 ring-border hover:ring-primary/40",
+      )}
+    >
+      {anime.poster ? (
+        <img
+          src={anime.poster}
+          alt=""
+          className="h-14 w-10 shrink-0 rounded-md object-cover"
+        />
+      ) : (
+        <div className="h-14 w-10 shrink-0 rounded-md bg-surface-2" />
+      )}
+      <div className="min-w-0">
+        <p className="line-clamp-2 text-sm font-medium leading-snug">
+          {anime.title}
+        </p>
+        <p className="mt-0.5 text-[11px] text-muted-foreground">
+          {detail ?? `AniList ${anime.anilistId}`}
+        </p>
+      </div>
+    </button>
+  );
+}
