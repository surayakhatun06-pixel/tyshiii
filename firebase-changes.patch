diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..e67415e
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,61 @@
+rules_version = '2';
+
+// TYSHI ZONE Firestore rules
+// - Everyone can READ anime and episode lists (needed to watch).
+// - Only admins can WRITE. An admin is a signed-in user that has a document at
+//   admins/{their uid}. Create those documents by hand in the Firebase console;
+//   the browser can never create, change or list them.
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    function isAdmin() {
+      return request.auth != null
+        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
+    }
+
+    function stampedNow() {
+      return request.resource.data.updatedAt == request.time;
+    }
+
+    match /admins/{uid} {
+      allow get: if request.auth != null && request.auth.uid == uid;
+      allow list, write: if false;
+    }
+
+    match /anime/{animeId} {
+      allow read: if true;
+      allow create, update: if isAdmin()
+        && stampedNow()
+        && request.resource.data.keys().hasOnly(
+             ['anilistId', 'title', 'poster', 'episodeCount', 'subCount', 'dubCount', 'updatedAt'])
+        && request.resource.data.anilistId is int
+        && string(request.resource.data.anilistId) == animeId
+        && request.resource.data.title is string
+        && request.resource.data.title.size() > 0
+        && request.resource.data.title.size() <= 300
+        && (request.resource.data.poster == null
+            || (request.resource.data.poster is string && request.resource.data.poster.size() <= 2000))
+        && (!('episodeCount' in request.resource.data) || request.resource.data.episodeCount is int)
+        && (!('subCount' in request.resource.data) || request.resource.data.subCount is int)
+        && (!('dubCount' in request.resource.data) || request.resource.data.dubCount is int);
+      allow delete: if isAdmin();
+    }
+
+    match /episodeLists/{animeId} {
+      allow read: if true;
+      allow create, update: if isAdmin()
+        && stampedNow()
+        && request.resource.data.keys().hasOnly(['anilistId', 'episodes', 'updatedAt'])
+        && request.resource.data.anilistId is int
+        && string(request.resource.data.anilistId) == animeId
+        && request.resource.data.episodes is map
+        && request.resource.data.episodes.size() <= 5000;
+      allow delete: if isAdmin();
+    }
+
+    // Everything else is closed.
+    match /{document=**} {
+      allow read, write: if false;
+    }
+  }
+}
