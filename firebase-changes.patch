+++ b/src/routes/admin.tsx
@@ -0,0 +1,123 @@
+import { useEffect, useState } from "react";
+import { createFileRoute, Link } from "@tanstack/react-router";
+import { ExternalLink, Loader2 } from "lucide-react";
+
+import { SiteShell } from "@/components/site-shell";
+import { AdminGate } from "@/components/admin/admin-gate";
+import { AnimePicker } from "@/components/admin/anime-picker";
+import {
+  AnimeDetailsForm,
+  EpisodeTable,
+} from "@/components/admin/episode-table";
+import { LinkImporter } from "@/components/admin/link-importer";
+import {
+  watchEpisodeList,
+  type AnimeRef,
+  type CloudEpisode,
+} from "@/lib/cloud-episodes";
+import { describeFirebaseError } from "@/lib/firebase";
+
+export const Route = createFileRoute("/admin")({
+  head: () => ({
+    meta: [
+      { title: "Admin | TYSHI ZONE" },
+      { name: "robots", content: "noindex, nofollow" },
+    ],
+  }),
+  component: AdminPage,
+});
+
+function AdminPage() {
+  return (
+    <SiteShell>
+      <div className="mx-auto max-w-[1100px] px-4 py-6 md:px-8">
+        <h1 className="text-2xl font-bold tracking-tight md:text-3xl">Admin</h1>
+        <p className="mt-1 max-w-2xl text-sm text-muted-foreground">
+          Add anime and SUB/DUB episode links to Firestore. Changes go live for
+          every visitor immediately — no redeploy needed.
+        </p>
+        <div className="mt-6">
+          <AdminGate>{() => <Dashboard />}</AdminGate>
+        </div>
+      </div>
+    </SiteShell>
+  );
+}
+
+function Dashboard() {
+  const [anime, setAnime] = useState<AnimeRef | null>(null);
+  const [episodes, setEpisodes] = useState<CloudEpisode[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!anime) return;
+    setEpisodes(null);
+    setError(null);
+    return watchEpisodeList(
+      anime.anilistId,
+      (eps) => {
+        setEpisodes(eps);
+        setError(null);
+      },
+      (err) => setError(describeFirebaseError(err)),
+    );
+  }, [anime?.anilistId]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  return (
+    <div className="space-y-6">
+      <AnimePicker value={anime} onChange={setAnime} />
+
+      {anime && (
+        <>
+          <div className="flex flex-wrap items-center justify-between gap-3">
+            <h2 className="text-lg font-semibold tracking-tight">
+              2. {anime.title}
+            </h2>
+            <Link
+              to="/anime/$id/watch"
+              params={{ id: String(anime.anilistId) }}
+              target="_blank"
+              className="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary"
+            >
+              Open watch page <ExternalLink className="size-3.5" />
+            </Link>
+          </div>
+
+          <AnimeDetailsForm
+            key={anime.anilistId}
+            anime={anime}
+            onSaved={setAnime}
+          />
+
+          {error ? (
+            <p className="rounded-xl border border-destructive/50 bg-destructive/10 p-4 text-sm text-destructive">
+              {error}
+            </p>
+          ) : episodes === null ? (
+            <p className="flex items-center gap-2 py-8 text-sm text-muted-foreground">
+              <Loader2 className="size-4 animate-spin" /> Loading episodes…
+            </p>
+          ) : (
+            <>
+              <div className="grid gap-6 lg:grid-cols-2">
+                <LinkImporter
+                  key={`sub-${anime.anilistId}`}
+                  anime={anime}
+                  lang="sub"
+                  existing={episodes}
+                />
+                <LinkImporter
+                  key={`dub-${anime.anilistId}`}
+                  anime={anime}
+                  lang="dub"
+                  existing={episodes}
+                />
+              </div>
+              <EpisodeTable anime={anime} episodes={episodes} />
+            </>
+          )}
+        </>
+      )}
+    </div>
+  );
