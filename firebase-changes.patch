+      >
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>
+              {pending &&
+                (pending.lang
+                  ? `Remove the ${pending.lang.toUpperCase()} link from ${describeNumbers(pending.numbers)}?`
