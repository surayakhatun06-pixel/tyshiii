+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { Loader2, Pencil, Plus, Trash2, X } from "lucide-react";
+import { toast } from "sonner";
+
+import {
+  AlertDialog,
+  AlertDialogAction,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog";
+import {
+  deleteEpisodes,
+  saveAnimeDetails,
+  saveEpisode,
+  type AnimeRef,
+  type CloudEpisode,
+  type Lang,
+} from "@/lib/cloud-episodes";
+import { describeFirebaseError } from "@/lib/firebase";
+import { toEmbed } from "@/lib/video-embed";
+import { cn } from "@/lib/utils";
+
+const input =
+  "h-10 w-full rounded-xl border border-border bg-surface px-3 text-sm outline-none transition placeholder:text-muted-foreground/60 focus:border-primary";
+
+function validImage(v: string) {
+  if (!v.trim()) return true;
+  try {
+    return ["http:", "https:"].includes(new URL(v.trim()).protocol);
+  } catch {
+    return false;
+  }
+}
+
+/** Title + poster stored in the `anime` collection. */
+export function AnimeDetailsForm({
+  anime,
+  onSaved,
+}: {
+  anime: AnimeRef;
+  onSaved: (anime: AnimeRef) => void;
+}) {
+  const [title, setTitle] = useState(anime.title);
+  const [poster, setPoster] = useState(anime.poster ?? "");
+  const [busy, setBusy] = useState(false);
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    if (!title.trim()) return toast.error("Add a title.");
+    if (!validImage(poster))
+      return toast.error("Poster must be an https:// image link.");
+    setBusy(true);
+    try {
+      const next = {
+        ...anime,
+        title: title.trim(),
+        poster: poster.trim() || null,
+      };
+      await saveAnimeDetails(next);
+      onSaved(next);
+      toast.success("Anime details saved.");
+    } catch (error) {
+      toast.error(describeFirebaseError(error));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form
+      onSubmit={submit}
+      className="flex flex-col gap-4 rounded-2xl border border-border bg-surface/40 p-4 md:flex-row md:items-end md:p-5"
+    >
+      {poster && validImage(poster) ? (
+        <img
+          src={poster}
+          alt=""
+          className="h-28 w-20 shrink-0 rounded-lg object-cover"
+        />
+      ) : (
+        <div className="h-28 w-20 shrink-0 rounded-lg bg-surface-2" />
+      )}
+      <div className="grid flex-1 gap-3 md:grid-cols-2">
+        <label className="text-xs text-muted-foreground">
+          Title
+          <input
+            value={title}
+            onChange={(e) => setTitle(e.target.value)}
+            className={cn(input, "mt-1")}
+          />
+        </label>
+        <label className="text-xs text-muted-foreground">
+          Poster image link
+          <input
+            value={poster}
+            onChange={(e) => setPoster(e.target.value)}
+            placeholder="https://…"
+            className={cn(
+              input,
+              "mt-1",
+              !validImage(poster) && "border-destructive",
+            )}
+          />
+        </label>
+        <p className="text-[11px] text-muted-foreground md:col-span-2">
+          AniList ID {anime.anilistId}. Used for the “Available to watch” row on
+          your home page.
+        </p>
+      </div>
+      <button
+        type="submit"
+        disabled={busy}
+        className="inline-flex h-10 items-center gap-2 rounded-full border border-border px-5 text-sm transition hover:border-primary disabled:opacity-50"
+      >
+        {busy && <Loader2 className="size-4 animate-spin" />}
+        Save details
+      </button>
+    </form>
+  );
+}
+
+type Draft = {
+  number: string;
+  title: string;
+  thumbnail: string;
+  subUrl: string;
+  dubUrl: string;
+};
+
+function EpisodeForm({
+  anime,
+  initial,
+  taken,
+  onDone,
+}: {
+  anime: AnimeRef;
+  initial?: CloudEpisode;
+  taken: Set<number>;
+  onDone: () => void;
+}) {
+  const [d, setD] = useState<Draft>({
+    number: initial
+      ? String(initial.number)
+      : String(Math.max(0, ...taken) + 1),
+    title: initial?.title ?? "",
+    thumbnail: initial?.thumbnail ?? "",
+    subUrl: initial?.subUrl ?? "",
+    dubUrl: initial?.dubUrl ?? "",
+  });
+  const [busy, setBusy] = useState(false);
+  const set = (p: Partial<Draft>) => setD((x) => ({ ...x, ...p }));
+
+  const n = Number(d.number);
+  const numberError =
+    !Number.isSafeInteger(n) || n < 1
+      ? "Positive whole number"
+      : taken.has(n) && n !== initial?.number
+        ? "Already exists"
+        : null;
+  const sub = d.subUrl.trim() ? toEmbed(d.subUrl) : null;
+  const dub = d.dubUrl.trim() ? toEmbed(d.dubUrl) : null;
+  const subError = d.subUrl.trim() && !sub ? "That link didn't parse" : null;
+  const dubError = d.dubUrl.trim() && !dub ? "That link didn't parse" : null;
+
+  async function submit(e: FormEvent) {
+    e.preventDefault();
+    if (numberError || subError || dubError)
+      return toast.error("Fix the highlighted fields.");
+    if (!sub && !dub) return toast.error("Add a SUB or DUB link.");
+    if (!validImage(d.thumbnail))
+      return toast.error("Thumbnail must be an https:// image link.");
+    setBusy(true);
+    try {
+      await saveEpisode(
+        anime,
+        {
+          number: n,
+          title: d.title.trim().slice(0, 200) || undefined,
+          thumbnail: d.thumbnail.trim() || undefined,
+          subUrl: sub?.src,
+          dubUrl: dub?.src,
+        },
+        initial?.number,
+      );
+      toast.success(`Episode ${n} saved.`);
+      onDone();
+    } catch (error) {
+      toast.error(describeFirebaseError(error));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form
+      onSubmit={submit}
+      className="grid gap-2 rounded-xl bg-surface p-3 md:grid-cols-6"
+    >
+      <label className="text-[11px] text-muted-foreground">
+        Episode
+        <input
+          value={d.number}
+          onChange={(e) => set({ number: e.target.value.replace(/\D/g, "") })}
+          inputMode="numeric"
+          className={cn(
+            input,
+            "mt-1 tabular-nums",
+            numberError && "border-destructive",
+          )}
+        />
+        {numberError && <span className="text-destructive">{numberError}</span>}
+      </label>
+      <label className="text-[11px] text-muted-foreground md:col-span-2">
+        Title (optional)
+        <input
+          value={d.title}
+          onChange={(e) => set({ title: e.target.value })}
+          className={cn(input, "mt-1")}
+        />
+      </label>
+      <label className="text-[11px] text-muted-foreground md:col-span-3">
+        Thumbnail link (optional)
+        <input
+          value={d.thumbnail}
+          onChange={(e) => set({ thumbnail: e.target.value })}
+          className={cn(
+            input,
+            "mt-1",
+            !validImage(d.thumbnail) && "border-destructive",
+          )}
+        />
+      </label>
+      <label className="text-[11px] text-muted-foreground md:col-span-3">
+        SUB link or iframe code
+        <input
+          value={d.subUrl}
+          onChange={(e) => set({ subUrl: e.target.value })}
+          placeholder="https://… or <iframe …>"
+          className={cn(input, "mt-1", subError && "border-destructive")}
+        />
+        {subError && <span className="text-destructive">{subError}</span>}
+      </label>
+      <label className="text-[11px] text-muted-foreground md:col-span-3">
+        DUB link or iframe code
+        <input
+          value={d.dubUrl}
+          onChange={(e) => set({ dubUrl: e.target.value })}
+          placeholder="https://… or <iframe …>"
+          className={cn(input, "mt-1", dubError && "border-destructive")}
+        />
+        {dubError && <span className="text-destructive">{dubError}</span>}
+      </label>
+      <div className="flex justify-end gap-2 md:col-span-6">
+        <button
+          type="button"
+          onClick={onDone}
+          className="h-9 rounded-full px-4 text-sm text-muted-foreground hover:text-foreground"
+        >
+          Cancel
+        </button>
+        <button
+          type="submit"
+          disabled={busy}
+          className="inline-flex h-9 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground disabled:opacity-50"
+        >
+          {busy && <Loader2 className="size-4 animate-spin" />}
+          Save episode
+        </button>
+      </div>
+    </form>
+  );
+}
+
+type PendingDelete = { numbers: number[]; lang?: Lang };
+
+const toolButton =
+  "inline-flex h-8 items-center gap-1 rounded-full border border-border px-3 text-xs transition hover:border-destructive hover:text-destructive disabled:opacity-50";
+
+function describeNumbers(numbers: number[]) {
+  return numbers.length === 1
+    ? `episode ${numbers[0]}`
+    : `${numbers.length} episodes`;
+}
+
+function SelectAllBox({
+  checked,
+  indeterminate,
+  onChange,
