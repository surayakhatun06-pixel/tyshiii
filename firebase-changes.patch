@@ -0,0 +1,46 @@
+import { useEffect, useState } from "react";
+
+import { AnimeRow } from "@/components/anime-row";
+import type { MediaCard } from "@/lib/anilist";
+import { watchCatalog, type CloudAnime } from "@/lib/cloud-episodes";
+import { firebaseConfigured } from "@/lib/firebase";
+
+function toCard(a: CloudAnime): MediaCard {
+  return {
+    id: a.anilistId,
+    title: { romaji: a.title, english: a.title, native: null },
+    coverImage: { extraLarge: a.poster, large: a.poster, color: null },
+    bannerImage: null,
+    format: null,
+    status: null,
+    episodes: a.episodeCount || null,
+    averageScore: null,
+    seasonYear: null,
+    genres: [],
+    description: null,
+    nextAiringEpisode: null,
+  };
+}
+
+/** Titles that have episodes in Firestore. Hidden until there is something to show. */
+export function CloudCatalogRow() {
+  const [anime, setAnime] = useState<CloudAnime[]>([]);
+
+  useEffect(() => {
+    if (!firebaseConfigured) return;
+    return watchCatalog(
+      (list) => setAnime(list.filter((a) => a.episodeCount > 0)),
+      (error) => console.error(error),
+      30,
+    );
+  }, []);
+
+  if (!anime.length) return null;
+  return (
+    <AnimeRow
+      eyebrow="Ready to stream"
+      title="Available to watch"
+      media={anime.map(toCard)}
+    />
+  );
+}
diff --git a/src/hooks/use-cloud-episodes.ts b/src/hooks/use-cloud-episodes.ts
new file mode 100644
index 0000000..64ca0a8
--- /dev/null
+++ b/src/hooks/use-cloud-episodes.ts
@@ -0,0 +1,127 @@
+import { useEffect, useMemo, useState } from "react";
+
+import { useVideos, type SavedVideo } from "@/hooks/use-videos";
+import { watchEpisodeList, type CloudEpisode } from "@/lib/cloud-episodes";
+import { describeFirebaseError, firebaseConfigured } from "@/lib/firebase";
+
+export function cloudEpisodeId(number: number) {
+  return `ep-${number}`;
+}
+
+function toSaved(animeId: number, ep: CloudEpisode): SavedVideo {
+  return {
+    id: cloudEpisodeId(ep.number),
+    url: (ep.subUrl ?? ep.dubUrl)!,
+    title: ep.title || `Episode ${ep.number}`,
+    addedAt: 0,
+    animeId,
+    episode: ep.number,
+    thumbnail: ep.thumbnail,
+    subUrl: ep.subUrl,
+    dubUrl: ep.dubUrl,
+    cloud: true,
+  };
+}
+
+/** Live Firestore episodes for the given titles. */
+export function useCloudEpisodes(animeIds: number[]) {
+  const key = [
+    ...new Set(animeIds.filter((id) => Number.isSafeInteger(id) && id > 0)),
+  ]
+    .sort((a, b) => a - b)
+    .join(",");
+  const [byAnime, setByAnime] = useState<Map<number, SavedVideo[]>>(new Map());
+  const [loaded, setLoaded] = useState<Set<number>>(new Set());
+  const [errors, setErrors] = useState<Map<number, string>>(new Map());
+  const [attempt, setAttempt] = useState(0);
+
+  useEffect(() => {
+    if (!firebaseConfigured || !key) return;
+    const ids = key.split(",").map(Number);
+    setLoaded(new Set());
+    setErrors(new Map());
+    const stops = ids.map((id) =>
+      watchEpisodeList(
+        id,
+        (episodes, offline) => {
+          setByAnime((m) =>
+            new Map(m).set(
+              id,
+              episodes.map((e) => toSaved(id, e)),
+            ),
+          );
+          setLoaded((s) => new Set(s).add(id));
+          setErrors((m) => {
+            const next = new Map(m);
+            if (offline)
+              next.set(
+                id,
+                "Couldn't reach the episode database. Check your connection.",
+              );
+            else next.delete(id);
+            return next;
+          });
+        },
+        (error) => {
+          console.error(error);
+          setLoaded((s) => new Set(s).add(id));
+          setErrors((m) => new Map(m).set(id, describeFirebaseError(error)));
+        },
+      ),
+    );
+    return () => stops.forEach((stop) => stop());
+  }, [key, attempt]);
+
+  const ids = useMemo(() => (key ? key.split(",").map(Number) : []), [key]);
+  const current = useMemo(
+    () =>
+      new Map(
+        ids.flatMap((id) => {
+          const eps = byAnime.get(id);
+          return eps ? [[id, eps] as const] : [];
+        }),
+      ),
+    [ids, byAnime],
+  );
+  const ready = !firebaseConfigured || ids.every((id) => loaded.has(id));
+  const error = ids.map((id) => errors.get(id)).find(Boolean) ?? null;
+  return {
+    byAnime: current,
+    ready,
+    error,
+    retry: () => setAttempt((a) => a + 1),
+  };
+}
+
+/**
+ * Browser-saved episodes plus Firestore episodes for the given titles. When both
+ * have the same episode number, the Firestore one wins (it's what every visitor sees).
+ */
+export function useEpisodeLibrary(animeIds: number[]) {
+  const { videos: local, ready: localReady } = useVideos();
+  const cloud = useCloudEpisodes(animeIds);
+
+  const videos = useMemo(() => {
+    if (!cloud.byAnime.size) return local;
+    const taken = new Map<number, Set<number>>();
+    const cloudVideos: SavedVideo[] = [];
+    for (const [animeId, eps] of cloud.byAnime) {
+      taken.set(animeId, new Set(eps.map((e) => e.episode!)));
+      cloudVideos.push(...eps);
+    }
+    const kept = local.filter(
+      (v) =>
+        v.animeId === undefined ||
+        v.episode === undefined ||
+        !taken.get(v.animeId)?.has(v.episode),
+    );
+    return [...kept, ...cloudVideos];
+  }, [local, cloud.byAnime]);
+
+  return {
+    videos,
+    ready: localReady && cloud.ready,
+    error: cloud.error,
+    retry: cloud.retry,
+  };
+}
